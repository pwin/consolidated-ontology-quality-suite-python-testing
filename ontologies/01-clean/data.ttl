@prefix :     <https://example.org/test/clean#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:alice
    a          :Person , owl:NamedIndividual ;
    rdfs:label "Alice"@en ;
    :fullName  "Alice Example" ;
    :worksFor  :acme .

:acme
    a          :Organization , owl:NamedIndividual ;
    rdfs:label "ACME Ltd"@en .
