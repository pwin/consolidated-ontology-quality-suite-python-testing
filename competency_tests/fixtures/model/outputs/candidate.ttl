# Candidate: output of the same pipeline after a mapping change. Six
# differences are seeded, one per review-aid competency test.
#
#  CT-23  wt: is a new prefix for the namespace baseline calls water:, and
#         qudt: is declared here only.
#  CT-24  wt:reportedBy replaces water:hasReading.
#  CT-25  one :PumpStation fewer (A4 is gone).
#  CT-26  site-S1's name and asset-A2's site both changed.
#  CT-27  "12.50"^^xsd:decimal and "8.0" are the same values as baseline's
#         written differently -- these must NOT be reported as changes.
#  CT-28  asset-A3 is minted as station-A3 here; skos:notation "A3" shows
#         it is the same real-world asset under a different identifier.
@prefix wt:    <https://example.org/water/model#> .
@prefix wdata: <https://example.org/water/data/> .
@prefix unit:  <https://example.org/water/units#> .
@prefix gist:  <https://w3id.org/semanticarts/ns/ontology/gist/> .
@prefix qudt:  <http://qudt.org/schema/qudt/> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

wdata:asset-A1 a wt:PumpStation ;
    skos:notation "A1" ;
    wt:atSite wdata:site-S1 ;
    wt:reportedBy wdata:reading-A1 .

wdata:asset-A2 a wt:PumpStation ;
    skos:notation "A2" ;
    wt:atSite wdata:site-S3 ;
    wt:reportedBy wdata:reading-A2 .

wdata:station-A3 a wt:PumpStation ;
    skos:notation "A3" ;
    wt:atSite wdata:site-S3 .

wdata:site-S1 a wt:Site ; wt:siteName "North Gate" .
wdata:site-S2 a wt:Site ; wt:siteName "Eastbrook" .
wdata:site-S3 a wt:Site ; wt:siteName "Westfield" .

wdata:reading-A1 a wt:Reading ;
    gist:numericValue "12.50"^^xsd:decimal ;
    gist:hasUnitOfMeasure unit:LitrePerSecond ;
    qudt:hasQuantityKind qudt:VolumeFlowRate .

wdata:reading-A2 a wt:Reading ;
    gist:numericValue "8.0" ;
    gist:hasUnitOfMeasure unit:LitrePerSecond .
