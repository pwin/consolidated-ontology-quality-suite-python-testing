PREFIX rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:   <http://www.w3.org/2002/07/owl#>
PREFIX sh:    <http://www.w3.org/ns/shacl#>
PREFIX oq:    <https://semantechs.co.uk/ontology-quality/>
PREFIX gist:  <https://w3id.org/semanticarts/ns/ontology/gist/>
PREFIX water: <https://example.org/water/model#>

# CMP-018 (CT-18): a numeric value hung directly off an entity that the
# agreed pattern says should reach it through a magnitude node.
#
# The VALUES table is the project rule: the class that must *not* carry the
# property directly, and the property it must not carry.
CONSTRUCT {
  _:r a sh:ValidationResult ;
    sh:resultSeverity sh:Violation ;
    sh:focusNode ?entity ;
    sh:resultPath ?flattened ;
    sh:value ?class ;
    sh:sourceConstraintComponent oq:CMP-018 ;
    sh:resultMessage ?msg .
}
WHERE {
  VALUES (?class ?flattened) {
    (water:Reading gist:numericValue)
  }
  ?entity a ?class ; ?flattened ?value .
  BIND(CONCAT(STR(?entity), " carries ", STR(?flattened), " directly. The agreed pattern puts ",
              "the number on a magnitude node reached from the ", STR(?class),
              ", which is the only place its unit and quantity kind can go.") AS ?msg)
}
