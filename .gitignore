# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Suite output (regenerated by report.py, gate.py and the CLI).
#
# No leading slash, deliberately: this matches every `out/` at any depth,
# including the one in each experiments/SpecificTests/*/ folder. Those hold
# a run's reports, are rebuilt on every run, and belong on the machine that
# ran it rather than in the repository. Anything a fixture *needs* lives in
# ontologies/, queries/, data/, expected/ or produced/ for that reason.
out/
.pytest_cache/
