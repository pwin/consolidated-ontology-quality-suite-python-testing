@prefix vocab: <https://example.org/water/vocab#> .
@prefix :      <https://example.org/water/model#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .

# The taxonomy: every asset type the data is allowed to use. Authoritative,
# and short enough to read -- which is the point of a controlled vocabulary.

vocab:Reservoir a :AssetType ;
    skos:prefLabel  "Reservoir"@en ;
    skos:definition "A structure holding a body of water for supply."@en .

vocab:Borehole a :AssetType ;
    skos:prefLabel  "Borehole"@en ;
    skos:definition "A shaft sunk to draw water from an aquifer."@en .
