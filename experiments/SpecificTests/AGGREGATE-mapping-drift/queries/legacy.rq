# The legacy import, kept because it still runs nightly.
prefix : <https://example.org/water/model#>

CONSTRUCT {
  ?reading_IRI a :Reading ;
    # SEEDS CT-35: the same property readings.rq types xsd:decimal, left as
    # a plain string here. Neither file is wrong on its own.
    :flowValue ?flow .
}
WHERE {
  BIND(IRI(CONCAT("https://example.org/water/data/reading-", ?readingid)) AS ?reading_IRI)
}
