@prefix :     <https://example.org/water/model#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Version 1.1.0 -- the CONTROL. One class added, nothing removed or
# renamed, so nothing built against 1.0.0 can break.

<https://example.org/water/model>
    a               owl:Ontology ;
    owl:versionIRI  <https://example.org/water/model/1.1.0> ;
    owl:versionInfo "1.1.0" ;
    rdfs:label      "Minimal water model"@en .

# Removed in the breaking version, kept in the compatible one.
:PumpStation
    a               owl:Class ;
    rdfs:label      "Pump station"@en ;
    skos:prefLabel  "PumpStation"@en ;
    skos:definition "A station that pumps water through the network."@en .

# CONTROL: unchanged across both versions.
:Site
    a               owl:Class ;
    rdfs:label      "Site"@en ;
    skos:prefLabel  "Site"@en ;
    skos:definition "A place at which the operator owns or monitors assets."@en .

skos:prefLabel  a owl:AnnotationProperty .
skos:definition a owl:AnnotationProperty .

:Reservoir
    a               owl:Class ;
    rdfs:label      "Reservoir"@en ;
    skos:prefLabel  "Reservoir"@en ;
    skos:definition "A structure holding a body of water for supply."@en .
