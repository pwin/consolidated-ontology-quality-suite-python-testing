@prefix :     <https://example.org/water/model#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix gist: <https://w3id.org/semanticarts/ns/ontology/gist/> .

<https://example.org/water/model>
    a               owl:Ontology ;
    owl:versionIRI  <https://example.org/water/model/2.0.0> ;
    owl:versionInfo "2.0.0" ;
    rdfs:label      "Minimal water model"@en .

# Version 2.0.0. :PumpStation was renamed :PumpingStation here, and the
# mapping was never updated.
:PumpingStation
    a               owl:Class ;
    rdfs:label      "Pumping station"@en ;
    skos:prefLabel  "PumpingStation"@en ;
    skos:definition "A station that pumps water through the network."@en .

# CONTROL: unchanged from 1.0.0, and still built by the mapping.
:Site
    a               owl:Class ;
    rdfs:label      "Site"@en ;
    skos:prefLabel  "Site"@en ;
    skos:definition "A place at which the operator owns or monitors assets."@en .

skos:prefLabel  a owl:AnnotationProperty .
skos:definition a owl:AnnotationProperty .
