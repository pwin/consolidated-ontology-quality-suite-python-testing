@prefix :     <https://example.org/water/model#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix gist: <https://w3id.org/semanticarts/ns/ontology/gist/> .

<https://example.org/water/model>
    a               owl:Ontology ;
    owl:versionIRI  <https://example.org/water/model/1.0.0> ;
    owl:versionInfo "1.0.0" ;
    rdfs:label      "Minimal water model"@en .

@prefix dcterms: <http://purl.org/dc/terms/> .

# The current model. :PumpStation is on its way out and says so.
:PumpStation
    a                    owl:Class ;
    owl:deprecated       true ;
    dcterms:isReplacedBy :PumpingStation ;
    rdfs:label           "Pump station"@en ;
    skos:prefLabel       "PumpStation"@en ;
    skos:definition      "Superseded by :PumpingStation."@en .

:PumpingStation
    a               owl:Class ;
    rdfs:label      "Pumping station"@en ;
    skos:prefLabel  "PumpingStation"@en ;
    skos:definition "A station that pumps water through the network."@en .

# CONTROL: current, and not going anywhere.
:Site
    a               owl:Class ;
    rdfs:label      "Site"@en ;
    skos:prefLabel  "Site"@en ;
    skos:definition "A place at which the operator owns or monitors assets."@en .

skos:prefLabel  a owl:AnnotationProperty .
skos:definition a owl:AnnotationProperty .
